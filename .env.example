# 외부에서 추측하기 어려운 충분히 긴 값으로 설정하세요.
ADMIN_KEY=
# 로컬 HTTP 테스트에서만 false, 실제 HTTPS 운영은 true
ADMIN_COOKIE_SECURE=true
# 관리자 HTTPS URL (프록시 뒤에서는 반드시 설정)
ADMIN_ORIGIN=

# VWorld 웹 API 인증키. 운영 도메인을 허용 도메인으로 등록하세요.
VWORLD_API_KEY=

# 카카오 Developers REST API 키
KAKAO_REST_API_KEY=

# 공공데이터포털 국세청 사업자등록 상태조회 서비스 키
NTS_SERVICE_KEY=

# 공공데이터포털 한국조폐공사 통합 가맹점기본정보 서비스 키
KOMSCO_SERVICE_KEY=

# 공공데이터포털 행정안전부 음식업 인허가 조회서비스 키
MOIS_SERVICE_KEY=

# 최초 실행 시 테스트 데이터 생성 여부
LOAD_SAMPLE_DATA=false

# 선택: SQLite 파일 저장 디렉터리
# DATA_DIR=/var/lib/donggurang-pay

# 주민 요청 허용 출처. 여러 개는 쉼표로 구분
PUBLIC_ORIGINS=https://lch854053.github.io
# 선택: IP 해시용 별도 비밀값. 미설정 시 ADMIN_KEY 사용
RATE_LIMIT_SECRET=
# 주기적 상태 조회는 정보 표시만 갱신하며 지도 제외를 하지 않음
ENABLE_WEEKLY_STATUS_CHECK=false
# 선택: 서버에서 배포 PR 생성용 GitHub fine-grained token
GITHUB_PUBLISH_TOKEN=
GITHUB_REPOSITORY=lch854053/donggurang-pay
